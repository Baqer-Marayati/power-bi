	partition Fact_FxDocument = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=HANA_B1", "SELECT 'A/P Invoice' AS ""DocType"", ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCur"" AS ""DocCurrency"", ""DocRate"", ""DocTotal"" AS ""TotalLC"", ""DocTotalFC"" AS ""TotalFC"", ""DocTotalSy"" AS ""TotalSC""#(lf)FROM ""CANON"".""OPCH"" WHERE ""CANCELED"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'A/P Credit Memo', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCur"", ""DocRate"", -""DocTotal"", -""DocTotalFC"", -""DocTotalSy""#(lf)FROM ""CANON"".""ORPC"" WHERE ""CANCELED"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'A/P Down Payment', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCur"", ""DocRate"", ""DocTotal"", ""DocTotalFC"", ""DocTotalSy""#(lf)FROM ""CANON"".""ODPO"" WHERE ""CANCELED"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'Goods Receipt PO', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCur"", ""DocRate"", ""DocTotal"", ""DocTotalFC"", ""DocTotalSy""#(lf)FROM ""CANON"".""OPDN"" WHERE ""CANCELED"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'Outgoing Payment', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCurr"", ""DocRate"", ""DocTotal"", ""DocTotalFC"", ""DocTotalSy""#(lf)FROM ""CANON"".""OVPM"" WHERE ""Canceled"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'A/R Invoice', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCur"", ""DocRate"", ""DocTotal"", ""DocTotalFC"", ""DocTotalSy""#(lf)FROM ""CANON"".""OINV"" WHERE ""CANCELED"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'A/R Credit Memo', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCur"", ""DocRate"", -""DocTotal"", -""DocTotalFC"", -""DocTotalSy""#(lf)FROM ""CANON"".""ORIN"" WHERE ""CANCELED"" = 'N' AND ""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'Incoming Payment', ""DocEntry"", ""DocNum"", ""DocDate"", ""CardCode"", ""CardName"", ""DocCurr"", ""DocRate"", ""DocTotal"", ""DocTotalFC"", ""DocTotalSy""#(lf)FROM ""CANON"".""ORCT"" WHERE ""Canceled"" = 'N' AND ""DocDate"" >= '2025-01-01'")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
