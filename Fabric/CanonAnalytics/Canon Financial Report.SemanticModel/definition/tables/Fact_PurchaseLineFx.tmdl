	partition Fact_PurchaseLineFx = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=HANA_B1", "SELECT 'Goods Receipt PO' AS ""DocType"", H.""DocEntry"", H.""DocNum"", L.""LineNum"", H.""DocDate"", H.""CardCode"", H.""CardName"", L.""ItemCode"", L.""Dscription"" AS ""ItemDescription"", L.""Quantity"", L.""Currency"" AS ""LineCurrency"", L.""Rate"" AS ""LineRate"", L.""Price"" AS ""UnitPriceFC"", L.""DiscPrcnt"" AS ""DiscountPct"", L.""LineTotal"" AS ""LineTotalLC"", L.""TotalFrgn"" AS ""LineTotalFC"", L.""TotalSumSy"" AS ""LineTotalSC""#(lf)FROM ""CANON"".""OPDN"" H INNER JOIN ""CANON"".""PDN1"" L ON L.""DocEntry"" = H.""DocEntry""#(lf)WHERE H.""CANCELED"" = 'N' AND H.""DocDate"" >= '2025-01-01'#(lf)UNION ALL#(lf)SELECT 'A/P Invoice', H.""DocEntry"", H.""DocNum"", L.""LineNum"", H.""DocDate"", H.""CardCode"", H.""CardName"", L.""ItemCode"", L.""Dscription"", L.""Quantity"", L.""Currency"", L.""Rate"", L.""Price"", L.""DiscPrcnt"", L.""LineTotal"", L.""TotalFrgn"", L.""TotalSumSy""#(lf)FROM ""CANON"".""OPCH"" H INNER JOIN ""CANON"".""PCH1"" L ON L.""DocEntry"" = H.""DocEntry""#(lf)WHERE H.""CANCELED"" = 'N' AND H.""DocDate"" >= '2025-01-01'")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
