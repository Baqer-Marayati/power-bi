	partition Fact_ItemPrice = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=HANA_B1", "SELECT#(lf)    I.""ItemCode"" AS ""ItemCode"",#(lf)    I.""ItemName"" AS ""ItemName"",#(lf)    I.""U_BusinessType"" AS ""BusinessType"",#(lf)    P.""PriceList"" AS ""PriceListNum"",#(lf)    L.""ListName"" AS ""PriceListName"",#(lf)    P.""Price"" AS ""Price"",#(lf)    P.""Currency"" AS ""PriceCurrency"",#(lf)    I.""AvgPrice"" AS ""AvgCostLC"",#(lf)    I.""LastPurPrc"" AS ""LastPurchasePrice"",#(lf)    I.""LastPurCur"" AS ""LastPurchaseCurrency"",#(lf)    I.""LastPurDat"" AS ""LastPurchaseDate"",#(lf)    I.""OnHand"" AS ""OnHand""#(lf)FROM ""CANON"".""OITM"" I#(lf)INNER JOIN ""CANON"".""ITM1"" P ON P.""ItemCode"" = I.""ItemCode""#(lf)LEFT JOIN ""CANON"".""OPLN"" L ON L.""ListNum"" = P.""PriceList""#(lf)WHERE I.""InvntItem"" = 'Y'#(lf)  AND COALESCE(P.""Price"", 0) <> 0")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
