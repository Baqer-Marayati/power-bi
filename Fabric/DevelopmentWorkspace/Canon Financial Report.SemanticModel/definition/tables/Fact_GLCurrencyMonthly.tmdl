	partition Fact_GLCurrencyMonthly = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=HANA_B1", "SELECT#(lf)    J.""Account"" AS ""AcctCode"",#(lf)    A.""AcctName"" AS ""AcctName"",#(lf)    LAST_DAY(J.""RefDate"") AS ""MonthEnd"",#(lf)    COALESCE(NULLIF(J.""FCCurrency"", ''), '(none)') AS ""FCCurrency"",#(lf)    TO_NVARCHAR(J.""TransType"") AS ""TransType"",#(lf)    SUM(COALESCE(J.""Debit"", 0)) AS ""DebitLC"",#(lf)    SUM(COALESCE(J.""Credit"", 0)) AS ""CreditLC"",#(lf)    SUM(COALESCE(J.""SYSDeb"", 0)) AS ""DebitSC"",#(lf)    SUM(COALESCE(J.""SYSCred"", 0)) AS ""CreditSC"",#(lf)    SUM(COALESCE(J.""FCDebit"", 0)) AS ""DebitFC"",#(lf)    SUM(COALESCE(J.""FCCredit"", 0)) AS ""CreditFC"",#(lf)    COUNT(*) AS ""Lines""#(lf)FROM ""CANON"".""JDT1"" J#(lf)INNER JOIN ""CANON"".""OACT"" A ON A.""AcctCode"" = J.""Account""#(lf)GROUP BY#(lf)    J.""Account"",#(lf)    A.""AcctName"",#(lf)    LAST_DAY(J.""RefDate""),#(lf)    COALESCE(NULLIF(J.""FCCurrency"", ''), '(none)'),#(lf)    TO_NVARCHAR(J.""TransType"")")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
